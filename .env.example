# ERP SaaS — 환경변수 본보기. 복사해서 .env.local 로 쓰세요(.env.local 은 git 에 안 올라간다).
# ⚠️ 이 프로젝트는 로하이마켓 운영 DB 와 무관한 "SaaS 전용" Supabase 프로젝트를 가리켜야 한다.

# ── SaaS Supabase 프로젝트 (브라우저가 읽는다) ──
VITE_SUPABASE_URL=https://<saas-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<saas anon key>

# ── 서버 함수만 읽는다(VITE_ 접두사 금지 — 번들로 새어 나간다) ──
SUPABASE_SERVICE_ROLE_KEY=<saas service role key>
# 가입 초대 코드. 비우면 가입이 닫힌다. SAAS_SIGNUP_OPEN=1 이면 누구나 가입.
SAAS_SIGNUP_CODE=
SAAS_SIGNUP_OPEN=
SAAS_TRIAL_DAYS=14

# ── 모드: saas 고정. company 는 로하이마켓 사내 배포 전용이었다 ──
VITE_MODE=saas

# ── 선택 ──
# AI 주문 분석(api/analyze). 없으면 주문 등록의 AI 분석이 꺼진다.
ANTHROPIC_API_KEY=
# 공휴일 API 등 기타 서버 함수 키는 각 api/*.js 머리말 참고

# ── 2026-10-20 추가 ─────────────────────────────────────────
# AI 분석(글·사진 읽기)은 유료 구독 회사 전용. 체험·데모 회사에 월 N회만 열어 주려면 숫자(기본 0 = 전면 거부).
SAAS_TRIAL_AI_CALLS=0
# 출고 안내 문자(유료 전용) — Coolsms. 셋 중 하나라도 비면 실제 발송 없이 서버 로그만 남긴다.
COOLSMS_API_KEY=
COOLSMS_API_SECRET=
COOLSMS_SENDER=
# 토스페이먼츠 빌링(카드 자동 결제). 둘 다 있어야 설정 화면의 결제가 켜진다. 없으면 "결제 연동 준비 중".
TOSS_SECRET_KEY=
VITE_TOSS_CLIENT_KEY=
SAAS_PRICE_BASIC=99000
SAAS_PRICE_PRO=199000
# 크론(/api/demo-cleanup, /api/billing-cron) 호출 확인용 비밀. Vercel 이 Authorization: Bearer 로 보낸다.
CRON_SECRET=8a649a398780dd360e9eceabc97dcf7264e5300fbbf5be4c049f9d3e41da2086
# 설정 화면 "데이터 이관 요청" 메일 주소(선택).
VITE_SUPPORT_EMAIL=
